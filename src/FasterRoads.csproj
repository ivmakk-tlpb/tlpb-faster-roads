<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build settings and the common game references live in Directory.Build.props. -->
  <PropertyGroup>
    <AssemblyName>FasterRoads</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- The road boost tile (UI) and the ground check (physics layers). -->
  <ItemGroup>
    <_Ref Include="$(BepInExInterop)\UnityEngine.UI.dll" />
    <_Ref Include="$(BepInExInterop)\UnityEngine.UIModule.dll" />
    <_Ref Include="$(BepInExInterop)\UnityEngine.PhysicsModule.dll" />
    <Reference Include="@(_Ref)">
      <HintPath>%(FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
